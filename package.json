{
  "name": "noder",
  "version": "0.1.3",
  "description": "A node-based creative workflow canvas for chaining AI calls",
  "author": "noder contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oshtz/noder.git"
  },
  "homepage": "https://github.com/oshtz/noder#readme",
  "bugs": {
    "url": "https://github.com/oshtz/noder/issues"
  },
  "keywords": [
    "ai",
    "workflow",
    "node-based",
    "creative",
    "image-generation",
    "replicate",
    "tauri",
    "react-flow"
  ],
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "start": "npm run tauri dev",
    "test": "vitest",
    "test:run": "vitest run",
    "test:smoke": "vitest run src/stores/__tests__/useSettingsStore.test.ts src/hooks/useUndoRedo.test.ts src/utils/workflowSchema.test.js src/utils/createNode.test.ts src/context/WorkflowContext.test.tsx",
    "test:release-smoke": "node scripts/check-release-workflow.mjs",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --no-config --ignore-path .prettierignore --single-quote --tab-width 2 --trailing-comma es5 --bracket-spacing --arrow-parens always --print-width 100 --end-of-line lf --write \"src/**/*.{js,jsx,ts,tsx,css}\" \"scripts/**/*.{js,mjs,cjs}\" \"*.{js,json,md}\" \".github/**/*.{yml,yaml}\" \"src-tauri/tauri.conf.json\" \"src-tauri/capabilities/**/*.json\"",
    "format:check": "node scripts/check-format.mjs",
    "analyze": "vite build --mode analyze",
    "prepare": "husky"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@reactflow/node-resizer": "^2.2.14",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.4.3",
    "chokidar": "^3.5.3",
    "fast-json-patch": "^3.1.1",
    "immer": "^11.1.3",
    "lz-string": "^1.5.0",
    "ogl": "^0.0.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-feather": "^2.0.10",
    "react-icons": "^5.4.0",
    "react-markdown": "^9.0.3",
    "reactflow": "^11.11.4",
    "zod": "^3.23.8",
    "zustand": "^5.0.14"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/lz-string": "^1.3.34",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.2.5",
    "rollup-plugin-visualizer": "^5.12.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
